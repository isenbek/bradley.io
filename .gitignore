.pyenv

# Pipeline caches
.*-timeline-cache.json
.summary-cache.json

# Rewritten every minute by cron (scripts/activity-pulse.py). Tracking it kept
# the working tree permanently dirty and made every deploy commit a new copy.
# It is machine state, not source: the file stays on disk and is still served.
/public/data/activity-pulse.json

# Local throwaways / personal exports
claude-remove.sh
docs/spicy-claude-web/

# misc (cross-platform)
Thumbs.db

# Playwright site audit
/test-results/
/playwright-report/
/playwright/.cache/

# Claude activity analytics export (private — never commit)
# House Calls private prospect data (PII firewall: only county rollups go public)
data/housecalls/
data/claude-activity.duckdb
data/claude-activity.duckdb.wal
data/claude-parquet/

# Repo code inventory (internal)
data/pilot-analytics*
data/claude-parquet/
data/claude-activity-export.zip
data/housecalls-stash/
public/harness/duckdb/

# Artifacts live on /mnt/ursa/bradleyio; these paths are SYMLINKS to it. The
# trailing-slash rules above match only real directories, so name the links.
/test-results
/playwright-report
data/claude-parquet

# Python bytecode from the pipeline scripts importing each other.
__pycache__/

# client previews served at /preview/<slug> (app/preview): client drafts stay off this public repo
/previews/
