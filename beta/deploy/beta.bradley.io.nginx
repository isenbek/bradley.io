# beta.bradley.io: the simplified bradley.io (isenbek/bradley.io beta/, on @tinymachines/kit). Static files; the shell for any
# path without a file (the app's routes); /api/ to the beta's own account service (deploy/bradleyio-beta-api.service, :8115).
# certbot --nginx adds the 443 server and the redirect to this file.
server {
    server_name beta.bradley.io;
    access_log /var/log/nginx/beta.bradley.io.access.log;
    error_log  /var/log/nginx/beta.bradley.io.error.log;
    root /var/www/beta.bradley.io;

    location /.well-known/acme-challenge/ { root /var/www/html; }

    location /api/ {
        proxy_pass              http://127.0.0.1:8115/;   # the trailing slash strips /api, as tinychase.com does
        proxy_http_version      1.1;
        proxy_set_header        Host $host;
        proxy_set_header        X-Real-IP $remote_addr;
        proxy_set_header        X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header        X-Forwarded-Proto $scheme;
        proxy_read_timeout      30s;
    }

    # (no types{} block at server level: it would replace the whole mime table)
    location = /index.html { add_header Cache-Control "no-cache" always; }
    location = /sw.js { add_header Cache-Control "no-cache" always; }
    location = /manifest.webmanifest { types { application/manifest+json webmanifest; } add_header Cache-Control "no-cache" always; }
    location /data/ { add_header Cache-Control "no-cache" always; }
    location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable" always; }
    location / { try_files $uri $uri/ /index.html; }

    listen 80;
    listen [::]:80;
}
