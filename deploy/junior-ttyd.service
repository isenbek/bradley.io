# TEMPORARY — PTY bridge for the unlisted /junior walkthrough page.
#
# Bound to loopback only (-i lo). The public path /junior/pty is gated in nginx
# by `auth_request` -> /api/junior/check, which validates the PIN cookie. ttyd
# itself has no auth, so it must NEVER be bound to a public interface.
#
# Install:  sudo cp deploy/junior-ttyd.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now junior-ttyd
# Teardown: see docs/junior-teardown.md
[Unit]
Description=ttyd for /junior (temporary OpenWrt walkthrough)
After=network.target

[Service]
Type=simple
User=bisenbek
Group=bisenbek
WorkingDirectory=/home/bisenbek
Environment="TERM=xterm-256color"
Environment="PATH=/home/bisenbek/.nvm/versions/node/v24.0.1/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
# NB: the double quotes in the theme JSON must be backslash-escaped. systemd
# treats bare `"` as its own quoting character and would strip them, handing
# ttyd invalid JSON.
ExecStart=/usr/bin/ttyd -i lo -p 7682 -b /junior/pty -O -m 8 -T xterm-256color -t fontSize=13 -t scrollback=5000 -t theme={\"background\":\"#0b1020\",\"foreground\":\"#d7e0f5\",\"cursor\":\"#4da3ff\",\"selection\":\"#294066\"} /usr/bin/tmux new -A -s junior
Restart=always
RestartSec=3
SyslogIdentifier=junior-ttyd

[Install]
WantedBy=multi-user.target
